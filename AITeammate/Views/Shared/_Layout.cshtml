<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dinosaur Roller</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gradient-navbar shadow-lg">
            <div class="container">
                <a class="navbar-brand brand-enhanced" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-dragon me-2"></i>
                    <span class="brand-text">Dinosaur Roller</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link nav-link-enhanced" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-enhanced" asp-area="" asp-controller="Dinosaurs" asp-action="Index">
                                <i class="fas fa-database me-1"></i>Dinosaur Database
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-enhanced btn-nav-cta" asp-area="" asp-controller="Roll" asp-action="Index">
                                <i class="fas fa-dice me-1"></i>Roll Dinosaur
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container main-content">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-enhanced mt-5">
        <div class="container">
            <div class="row py-4">
                <div class="col-md-6 text-center text-md-start">
                    <h5 class="text-white mb-2">
                        <i class="fas fa-dragon me-2"></i>Dinosaur Roller
                    </h5>
                    <p class="text-white-50 mb-0">Explore the prehistoric world!</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-white-50 mb-2">
                        <i class="far fa-copyright"></i> 2024 - Dinosaur Roller
                    </p>
                    <p class="text-white-50 small mb-0">
                        Made with <i class="fas fa-heart text-danger"></i> for dinosaur enthusiasts
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
