@model Dinosaur

@{
    ViewData["Title"] = "Details";
    
    string GetRankDisplay(DinosaurRank rank)
    {
        return rank switch
        {
            DinosaurRank.SubApex => "Sub-Apex",
            DinosaurRank.HighTier => "High-Tier",
            DinosaurRank.MidTier => "Mid-Tier",
            DinosaurRank.LowTier => "Low-Tier",
            _ => rank.ToString()
        };
    }
}

<h1>@Model.Name</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Rank</dt>
            <dd class="col-sm-9">@GetRankDisplay(Model.Rank)</dd>

            <dt class="col-sm-3">Diet</dt>
            <dd class="col-sm-9">@Model.Diet</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Sexual Dimorphism</dt>
            <dd class="col-sm-9">
                @if (Model.HasDimorphism)
                {
                    <span class="badge bg-success">Yes</span>
                    <p class="mt-2">@Model.DimorphismDescription</p>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
