@{
    ViewData["Title"] = "Roll Random Dinosaur";
}

<h1>?? Roll for a Random Dinosaur!</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Choose Your Filters</h5>
                <form asp-action="Random" method="post">
                    <div class="form-group mb-3">
                        <label for="rankFilter" class="form-label">Select Rank</label>
                        <select class="form-select" id="rankFilter" name="rankFilter">
                            <option value="all" selected>All Ranks (Fully Random)</option>
                            <option value="Apex">Apex</option>
                            <option value="SubApex">Sub-Apex</option>
                            <option value="HighTier">High-Tier</option>
                            <option value="MidTier">Mid-Tier</option>
                            <option value="LowTier">Low-Tier</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="dietFilter" class="form-label">Select Diet</label>
                        <select class="form-select" id="dietFilter" name="dietFilter">
                            <option value="all" selected>All Diets (Fully Random)</option>
                            <option value="Carnivore">Carnivore</option>
                            <option value="Herbivore">Herbivore</option>
                            <option value="Omnivore">Omnivore</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg">?? Roll Now!</button>
                </form>
            </div>
        </div>

        <div class="mt-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title">What You'll Get:</h6>
                    <ul>
                        <li>A random dinosaur from your selected filters</li>
                        <li>Randomly assigned gender (Male/Female)</li>
                        <li>Sexual dimorphism traits (if applicable)</li>
                        <li>A unique skin pattern/color</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Quick Guide</h5>
                <p><strong>Fully Random:</strong> Leave both filters on "All" to get any dinosaur!</p>
                <p><strong>Rank Filter:</strong> Select a specific rank to roll within that tier.</p>
                <p><strong>Diet Filter:</strong> Choose carnivore, herbivore, or omnivore.</p>
            </div>
        </div>
    </div>
</div>
