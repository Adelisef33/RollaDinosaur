@model DinosaurRoll

@{
    ViewData["Title"] = "Your Dinosaur Roll";
    
    string GetRankBadgeClass(DinosaurRank rank)
    {
        return rank switch
        {
            DinosaurRank.Apex => "danger",
            DinosaurRank.SubApex => "warning",
            DinosaurRank.HighTier => "info",
            DinosaurRank.MidTier => "primary",
            DinosaurRank.LowTier => "secondary",
            _ => "secondary"
        };
    }

    string GetRankDisplay(DinosaurRank rank)
    {
        return rank switch
        {
            DinosaurRank.SubApex => "Sub-Apex",
            DinosaurRank.HighTier => "High-Tier",
            DinosaurRank.MidTier => "Mid-Tier",
            DinosaurRank.LowTier => "Low-Tier",
            _ => rank.ToString()
        };
    }
}

<h1>?? Your Random Dinosaur Roll!</h1>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card border-success shadow-lg">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">@Model.Dinosaur.Name</h3>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h5>Classification</h5>
                        <p>
                            <span class="badge bg-@GetRankBadgeClass(Model.Dinosaur.Rank) fs-6">@GetRankDisplay(Model.Dinosaur.Rank)</span>
                            <span class="badge bg-@(Model.Dinosaur.Diet == DietType.Carnivore ? "danger" : Model.Dinosaur.Diet == DietType.Herbivore ? "success" : "warning") fs-6 ms-2">
                                @Model.Dinosaur.Diet
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h5>Gender</h5>
                        <p>
                            <span class="badge bg-@(Model.Gender == Gender.Male ? "primary" : "info") fs-6">
                                @Model.Gender @(Model.Gender == Gender.Male ? "?" : "?")
                            </span>
                        </p>
                    </div>
                </div>

                <div class="mb-3">
                    <h5>Description</h5>
                    <p>@Model.Dinosaur.Description</p>
                </div>

                @if (Model.ShowDimorphism && Model.Dinosaur.HasDimorphism)
                {
                    <div class="alert alert-info">
                        <h6><strong>Sexual Dimorphism Displayed!</strong></h6>
                        <p class="mb-0">@Model.Dinosaur.DimorphismDescription</p>
                    </div>
                }

                <div class="card bg-light mt-3">
                    <div class="card-body">
                        <h5>?? Skin Pattern</h5>
                        <h6 class="text-primary">@Model.Skin.Name</h6>
                        <p class="mb-1"><strong>Pattern:</strong> @Model.Skin.ColorPattern</p>
                        @if (!string.IsNullOrEmpty(Model.Skin.Description))
                        {
                            <p class="mb-0 text-muted">@Model.Skin.Description</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-success btn-lg">?? Roll Again</a>
            <a asp-controller="Dinosaurs" asp-action="Details" asp-route-id="@Model.Dinosaur.Id" class="btn btn-info">View Full Details</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Roll Summary</h5>
                <ul class="list-unstyled">
                    <li><strong>Species:</strong> @Model.Dinosaur.Name</li>
                    <li><strong>Rank:</strong> @GetRankDisplay(Model.Dinosaur.Rank)</li>
                    <li><strong>Diet:</strong> @Model.Dinosaur.Diet</li>
                    <li><strong>Gender:</strong> @Model.Gender</li>
                    <li><strong>Skin:</strong> @Model.Skin.Name</li>
                    <li><strong>Dimorphism:</strong> @(Model.ShowDimorphism && Model.Dinosaur.HasDimorphism ? "Yes" : "No")</li>
                </ul>
            </div>
        </div>

        <div class="card mt-3 bg-warning">
            <div class="card-body">
                <h6 class="card-title">?? Did You Know?</h6>
                <p class="small mb-0">This combination is completely unique! The chances of getting the exact same roll again are incredibly rare.</p>
            </div>
        </div>
    </div>
</div>
